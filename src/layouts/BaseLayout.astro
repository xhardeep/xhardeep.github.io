---
import '../styles/global.css';

interface Props {
	title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const { 
  title, 
  description = "Hardeep's personal blog about technology, thinking, and life.", 
  image = "/newgalaxy.jpg",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).toString()
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/jpeg" href="/newgalaxy.jpg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />
	</head>
	<body>
		<header class="site-header">
      <div class="container-wide">
        <div class="site-title">
          <a href="/" class="matrix-text" data-value="Hardeep">Hardeep</a>
        </div>
        <button class="menu-toggle" aria-label="Toggle menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav class="site-nav">
          <a href="/archive">Archive</a>
          <a href="https://x.com/xhardeep" target="_blank" rel="noopener noreferrer">Twitter</a>
        </nav>
      </div>
    </header>
    
    <div style="height: 50px;"></div>

		<slot />

    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const siteNav = document.querySelector('.site-nav');
      
      menuToggle?.addEventListener('click', () => {
        siteNav?.classList.toggle('is-active');
        menuToggle?.classList.toggle('is-active');
      });

      // AniMe Matrix Subtle Shuffle Effect
      const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*";
      
      const setupMatrixAnimation = (element) => {
        if (!element.dataset.value) {
          element.dataset.value = element.innerText;
        }
        
        let interval = null;
        let timeout = null;

        const startAnimation = () => {
          let iteration = 0;
          clearInterval(interval);
          clearTimeout(timeout);
          
          interval = setInterval(() => {
            element.innerText = element.innerText
              .split("")
              .map((letter, index) => {
                if(index < iteration) {
                  return element.dataset.value[index];
                }
                return letters[Math.floor(Math.random() * 44)]
              })
              .join("");
            
            if(iteration >= element.dataset.value.length){ 
              clearInterval(interval);
            }
            
            iteration += 1 / 2;
          }, 30);

          // 5-second safety net to ensure original text returns
          timeout = setTimeout(() => {
            clearInterval(interval);
            element.innerText = element.dataset.value;
          }, 5000);
        };
        
        element.addEventListener("mouseover", startAnimation);

        // Periodic glitch every 5 seconds for "Hardeep" name
        if (element.classList.contains('matrix-text')) {
          setInterval(startAnimation, 5000);
        }
      };

      // Apply to site title and all H1s
      document.querySelectorAll('.matrix-text, h1, .post-title').forEach(setupMatrixAnimation);
    </script>
	</body>
</html>
