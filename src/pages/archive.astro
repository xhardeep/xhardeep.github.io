---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const postsByYear = sortedPosts.reduce((acc, post) => {
	const year = post.data.date.getFullYear();
	if (!acc[year]) {
		acc[year] = [];
	}
	acc[year].push(post);
	return acc;
}, {} as Record<number, typeof allPosts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title="Archive | Hardeep">
	<main class="container">
		<h1 class="page-title">Archive</h1>

    <div class="search-container">
      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="archive-search" placeholder="Search..." aria-label="Search archive" />
        <button id="search-clear" class="search-clear" aria-label="Clear search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
    </div>
		
		{years.map((year) => (
			<section class="archive-year-section" data-year={year}>
				<h2 class="archive-year">{year}</h2>
				<ul class="archive-list">
					{postsByYear[Number(year)].map((post) => (
						<li class="archive-item" data-search-content={`${post.data.title} ${post.body}`.toLowerCase()}>
							<a href={`/posts/${post.id}/`} class="archive-link">
								{post.data.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		))}
	</main>
</BaseLayout>

<script>
  const searchInput = document.getElementById('archive-search') as HTMLInputElement;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement;
  const yearSections = document.querySelectorAll('.archive-year-section');

  const filterPosts = (query: string) => {
    yearSections.forEach((section) => {
      const items = section.querySelectorAll('.archive-item');
      let visibleCount = 0;

      items.forEach((item) => {
        const searchableText = (item as HTMLElement).dataset.searchContent || '';
        if (searchableText.includes(query)) {
          (item as HTMLElement).style.display = 'flex';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      (section as HTMLElement).style.display = visibleCount > 0 ? 'block' : 'none';
    });
    
    // Toggle clear button visibility
    if (searchClear) {
      searchClear.style.display = query.length > 0 ? 'flex' : 'none';
    }
  };

  searchInput?.addEventListener('input', (e) => {
    filterPosts((e.target as HTMLInputElement).value.toLowerCase().trim());
  });

  searchClear?.addEventListener('click', () => {
    searchInput.value = '';
    filterPosts('');
    searchInput.focus();
  });
</script>

<style>
	.page-title {
		margin-bottom: 1.5rem;
	}
  .search-container {
    margin-bottom: 3rem;
    position: relative;
  }
  .search-wrapper {
    display: flex;
    align-items: center;
    background: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding: 8px 0;
    transition: all 0.3s ease;
  }
  .search-wrapper:focus-within {
    border-bottom-color: var(--wp--preset--color--primary);
  }
  .search-icon {
    width: 16px;
    height: 16px;
    margin-right: 12px;
    opacity: 0.4;
  }
  .search-clear {
    display: none;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    opacity: 0.4;
    color: var(--wp--preset--color--foreground);
    transition: opacity 0.2s;
  }
  .search-clear:hover {
    opacity: 0.8;
  }
  .search-clear svg {
    width: 14px;
    height: 14px;
  }
  #archive-search {
    background: none;
    border: none;
    outline: none;
    color: var(--wp--preset--color--foreground);
    width: 100%;
    font-size: 0.95rem;
    font-family: inherit;
  }
  #archive-search::placeholder {
    color: var(--wp--preset--color--secondary);
    opacity: 0.6;
  }
	.archive-year-section {
		margin-bottom: 3rem;
	}
  @media (prefers-color-scheme: dark) {
    .search-wrapper {
      border-bottom-color: rgba(255, 255, 255, 0.15);
    }
  }
	.archive-year {
		font-family: var(--wp--preset--font-family--ibm-plex-mono);
		font-size: 2rem;
		border-bottom: 1px solid rgba(0,0,0,0.1);
		padding-bottom: 0.5rem;
		margin-bottom: 1.5rem;
	}
	.archive-list {
		list-style: none;
		padding: 0;
	}
	.archive-item {
		display: flex;
		gap: 2rem;
		margin-bottom: 1rem;
		align-items: baseline;
	}
	.archive-date {
		font-family: var(--wp--preset--font-family--ibm-plex-mono);
		color: var(--wp--preset--color--secondary);
		min-width: 80px;
		font-size: 0.9rem;
		text-transform: uppercase;
	}
	.archive-link {
		font-size: 1.25rem;
		font-weight: 500;
		color: var(--wp--preset--color--foreground);
	}
	.archive-link:hover {
		color: var(--wp--preset--color--primary);
		text-decoration: none;
	}

  @media (prefers-color-scheme: dark) {
    .archive-year {
      border-bottom-color: rgba(255,255,255,0.1);
    }
  }
</style>
