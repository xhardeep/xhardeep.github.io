---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Hardeep | Blog">
	<main class="container">
    <div class="podcast-bar">
      <span class="podcast-label">Podcast</span>
      <a href="https://open.spotify.com/show/55eSxT2jmp7cNsekMoX1oO?si=dc0452fa0e774b75" class="podcast-link" target="_blank" rel="noopener noreferrer">Spotify</a>
      <a href="https://youtube.com/@xhardeep" class="podcast-link" target="_blank" rel="noopener noreferrer">YouTube</a>
    </div>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li class="post-item">
						<h2 class="post-item-title">
							<a href={`/posts/${post.id}/`}>{post.data.title}</a>
						</h2>
						<div class="post-date">
							{post.data.date.toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'long',
								day: 'numeric',
							})}
						</div>
						<p class="post-excerpt">{post.data.description}</p>
					</li>
				))
			}
		</ul>
	</main>
</BaseLayout>
